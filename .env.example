# Server Port & Client URL
PORT=5000
CLIENT_URL=http://localhost:5173

# Google OAuth 2.0 Credentials
# Obtain these from https://console.cloud.google.com (APIs & Services > Credentials)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/callback

# JWT Cookie Encryption Secret
JWT_SECRET=mailcal-sync-super-secret-jwt-key-2026-change-in-production

# Polling Interval (in seconds) - How frequently to check Gmail in the background (default: 120)
POLL_INTERVAL_SECONDS=120

# Optional: Google Gemini API Key for LLM extraction (fallback to NLP heuristic engine if empty)
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=

# SQLite Database File Path (defaults to ./data/mailcal.db)
DB_PATH=./data/mailcal.db
